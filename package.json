{
  "name": "3d-print-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Phone-friendly 3D preview of sliced G-code: the print on the right build plate, with print time, grams per color and every line type.",
  "author": "Joey Hersh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joey12725/3d-print-visualizer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "deploy": "npm run build && ./scripts/deploy.sh",
    "share": "scripts/share.sh",
    "sample": "node scripts/sample-gcode.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
